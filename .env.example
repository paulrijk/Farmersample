# Copy to .env (npm run setup does this). Never commit .env.
# Public base URL that QR codes and e-mails point to. For a phone demo, set it to your tunnel URL.
PUBLIC_BASE_URL=http://localhost:8080

# Optional — Stripe test mode (M2). Leave empty to run with payments off.
STRIPE_API_KEY=
STRIPE_FORWARD_TO=gateway:80/api/v1/webhooks/stripe
