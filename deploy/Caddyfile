# One origin for everything, locally and in Azure: /, /admin, /api (and /field from M2).
{
	admin off
	# Trust the platform's own load balancer (Azure Container Apps, incl. its 100.64/10 range) so the API
	# learns the visitor's real address and that the request arrived over HTTPS.
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:80 {
	encode zstd gzip

	# Optional site-wide password (test environment): written by gateway-entrypoint.sh when SITE_PASSWORD is set.
	import /etc/caddy/auth*.caddy

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	redir /admin /admin/
	# Angular gives code files a content hash in their name (main-AB12CD34.js): cache those for a year.
	# Everything else (index.html for every page, logos) must be re-checked, or browsers keep showing an old version.
	@immutable path_regexp \-[A-Za-z0-9]{8}\.(js|css)$|\.woff2?$
	@revalidate not path_regexp \-[A-Za-z0-9]{8}\.(js|css)$|\.woff2?$

	handle_path /admin/* {
		root * /srv/backoffice
		try_files {path} /index.html
		header @revalidate Cache-Control "no-cache"
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/buyer-web
		try_files {path} /index.html
		header @revalidate Cache-Control "no-cache"
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
