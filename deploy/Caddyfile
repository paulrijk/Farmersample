# One origin for everything, locally and in Azure: /, /admin, /api (and /field from M2).
{
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	redir /admin /admin/
	# Angular gives code files a content hash in their name (main-AB12CD34.js): cache those for a year.
	# Everything else (index.html for every page, logos) must be re-checked, or browsers keep showing an old version.
	@immutable path_regexp \-[A-Za-z0-9]{8}\.(js|css)$|\.woff2?$
	@revalidate not path_regexp \-[A-Za-z0-9]{8}\.(js|css)$|\.woff2?$

	handle_path /admin/* {
		root * /srv/backoffice
		try_files {path} /index.html
		header @revalidate Cache-Control "no-cache"
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/buyer-web
		try_files {path} /index.html
		header @revalidate Cache-Control "no-cache"
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
